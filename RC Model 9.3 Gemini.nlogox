    <slider x="152" step="0.01" y="45" max="2" display="std-avg-income" height="33" min="0" direction="Horizontal" default="0.3" variable="std-avg-income" units="ratio" width="160" sizeVersion="0"></slider>
    <monitor x="531" precision="3" y="117" height="45" fontSize="11" display="turnover" width="53" sizeVersion="0"><![CDATA[; shows ratio of accumulated loans to accumulated surplus.
ifelse-value (capital > 0) [ out-flow / capital ] [ 0 ]]]></monitor>
    <monitor x="455" precision="3" y="117" height="45" fontSize="11" display="fin cost p.a.%" width="79" sizeVersion="0"><![CDATA[; shows effective annual cost of financing to debtors
ifelse-value (out-flow > 0) [ 100 * 12 * (total-acc-markup-payment + total-acc-interest-payment) / (60 * out-flow) ] [ 0 ]]]></monitor>
    <monitor x="381" precision="3" y="117" height="45" fontSize="11" display="return p.a.%" width="76" sizeVersion="0"><![CDATA[; shows annual return to creditors
ifelse-value (capital > 0) [ 100 * 12 * (total-acc-markup-payment + total-acc-interest-payment) / (60 * capital) ] [ 0 ]]]></monitor>
    <monitor x="252" precision="3" y="118" height="45" fontSize="11" display="pmt / loan" width="58" sizeVersion="0"><![CDATA[; shows total accumulated debt payments as a ratio
; of total accumulated extended loans
ifelse-value (out-flow > 0) [ total-acc-payment / out-flow ] [ 0 ]]]></monitor>
