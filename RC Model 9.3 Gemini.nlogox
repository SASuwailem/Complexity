<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[;; This version 9.3: NetLogo 7.04
;; 1. Modified marginal propensity to consume of income and of wealth to be a function
;; 2. Enhancements agianst division by zero.
;; 3. Specified precision of consistency checks to 5 decimals.
;; 4. Gemini Pro 3.1: https://share.gemini.google/bYFPJHy1WDGJ



globals
        [  seed-number time bankrupt acc-bankrupt consumption-ag consumption-md net-income-md wealth-ag net-income-ag net-worth-md
           net-worth-ag var-c var-y var-nw total-debt total-amount-due total-surplus total-deficit total-payment total-interest-due
           loan-share total-wealth total-net-worth net-wealth-ag net-wealth-md net-wealth-gap net-wealth-var
           total-interest-payment total-interest-past-due total-markup-payment
           total-markup-past-due loan-funds z-funds in-flow z-share eligible-deficit total-loan out-flow acc-c-wealth
           total-principal-payment total-acc-loan wealth-md wealth-ma var-w consumption-gap net-income-gap net-worth-gap total-acc-surplus total-initial-surplus
           total-acc-payment total-acc-principal-payment total-acc-markup-payment total-acc-interest-payment capital total-cash total-credit
           total-a-share total-c-share factor total-c-wealth total-net-wealth total-fresh-surplus total-donation total-charity lorenz-points gini-index-reserve
           ]

patches-own
       [  probability consumption income mean-income net-income p-income wealth donation class debt amount-due interest-c past-due interest-due
          interest-payment interest-past-due interest-share markup-payment markup-due markup-share markup-c markup-past-due credit initial-surplus surplus net-surplus
          loan default donor surplus-share  c-1 c-2 c-star avg-consumption payment interest-d installment-due principal-payment deficit net-worth
          gap charity d mpc mpc-w net-wealth principal-debt markup-debt interest-debt gross-debt no-of-loans acc-payment
          acc-loan acc-interest-payment acc-markup-payment acc-principal-payment acc-surplus acc-past-due
          c-share a-share net-share adj-share c-wealth adj-wealth fresh-surplus limit-loan ]




to setup
  clear-all
  set-random-seed
  setup-patches
  update-lorenz-and-gini

  ; to be sure not to have interest-lending and markup-financing simultaneously
  if (m > 0 and r > 0) [user-message "Warning: m & r > 0. r is set to zero"]
  if m > 0 [
    set r 0
    set limit-amount-due true
    ]
  reset-ticks
end




;; To be able to reproduce a certain simulation you need to fix the seed number of the random number generator.
to set-random-seed
   ifelse fix-random-seed
     [ let input-seed-number user-input "Type a seed number"
       set seed-number read-from-string input-seed-number
       random-seed seed-number ]
     [ set seed-number new-seed ]
   print (word "Seed number = " seed-number)
   print (word "Start at " date-and-time)
end



to setup-patches
  random-seed seed-number
  ask patches [

      ; set averge income for each agent and the mpc of income and wealth
      set mean-income avg-income + (random  (2 * std-avg-income * avg-income)) - (std-avg-income * avg-income)

      ;; ----------------------------------------------------
      ;; INITIAL DYNAMIC MPC & MPC-W CALCULATION (With Proportional Noise)
      ;; ----------------------------------------------------
      let lambda (1 / (mean-income + 0.01))

      ; 1. Calculate the theoretical baseline on the curve
      let base-mpc mpc-min + (mpc-max - mpc-min) * exp (-1 * lambda * mean-income)

      ; 2. Apply the stochastic noise proportionally
      set mpc base-mpc + (random-float (2 * std-mpc * base-mpc)) - (std-mpc * base-mpc)

      ; 3. Safety bounds to prevent impossible economic behavior
      if mpc > 0.99 [ set mpc 0.99 ]
      if mpc < 0 [ set mpc 0 ]


      ;; --- For Wealth ---
      let lambda-w (1 / ((mean-income * 5) + 0.01))

      let base-mpc-w mpc-w-min + (mpc-w-max - mpc-w-min) * exp (-1 * lambda-w * net-worth)

      set mpc-w base-mpc-w + (random-float (2 * std-mpc-w * base-mpc-w)) - (std-mpc-w * base-mpc-w)

      if mpc-w > 0.99 [ set mpc-w 0.99 ]
      if mpc-w < 0 [ set mpc-w 0 ]
      ;; ----------------------------------------------------


      set consumption mpc * mean-income
      set pcolor scale-color brown (consumption) 1 139

      ; set relative-consumption parameter
      set d relativity + (random-float (2 * std-r * relativity) ) - (std-r * relativity)
          if d >= 1 [set d .9]

      ; set initial surplus and wealth
      set initial-surplus 10
      set acc-surplus initial-surplus
      set wealth initial-surplus

      ; each agent is setup to be able to obtain financing (no default; no limit of credit)
      set default 0
      set limit-loan false
    ]

  set capital sum [acc-surplus] of patches
  set total-initial-surplus sum [initial-surplus] of patches
  set loan-funds total-initial-surplus
  set in-flow total-initial-surplus
  random-seed seed-number
end



to check-bankruptcy
   ask patches [
       if default = 0 [
          ; if amount of installment exceeds twice the average income, then agent's wealth will be used to pay off his debt--wealth is "confescated".
          if amount-due > 2 * mean-income
             [ ifelse net-worth > 0   ; if net-worth > o, this means the agent has more wealth than debt
               [ set c-wealth debt    ; the amount of confescated wealth (c-wealth) is equal to the outstanding debt.
                 set debt 0
                 set principal-debt 0
                 set markup-debt 0
                 set interest-debt 0
                 ]
             ; else, if net-worth <= 0, then the agent has less wealth than debt.
             [ set c-wealth wealth
                declare-bankruptcy ] ; end of else
            ] ; end of if amount-due > 2 * mean-income
          ] ; end of if default = 0
         ] ; end of ask
end



to check-markup-limit
   if limit-amount-due = true    ; in case of markup, creditors need to limit the amount of installment.
      [
        ask patches [
           if amount-due >= .5 * mean-income [
               if m > 0                              ; to avoid sensitivities of random number generator
                  [ ifelse wealth > 0.1 * gross-debt
                      [ set c-wealth 0.1 * gross-debt
                        set principal-debt principal-debt - ( (1 - markup-share) * c-wealth ) ; reduce principal-debt by its share
                            if principal-debt < 0 [set principal-debt 0]
                        set markup-debt markup-debt - ( markup-share * c-wealth ) ; reduce markup-debt by its share
                            if markup-debt < 0 [set markup-debt 0]
                        ;update debt
                        set debt principal-debt + markup-past-due
                        set limit-loan false
                        ]

                 ; else, if wealth <= 0.1 * gross-debt, then:
                 [ set limit-loan true ]
                 ] ; end of ifelse
                    ] ]; end of ask.
        ] ; end of markup finance condition
end



;; calculate total confescated wealth: c-wealth
to cal-c-wealth
   set total-c-wealth sum [c-wealth] of patches
   set acc-c-wealth acc-c-wealth + total-c-wealth
end



;;adjust shres of agents in aggregate wealth
to adjust-shares
   if total-c-wealth > 0   ;; c-wealth: confescated wealth
     [
       ask patches [
          ; --- Safe Division for Wealth ---
          set c-share ifelse-value (total-wealth != 0) [ c-wealth / total-wealth ] [ 0 ]
          set net-share ifelse-value (total-wealth != 0) [ (wealth - c-wealth) / total-wealth ] [ 0 ]

          ifelse c-wealth > 0
              [ set a-share 0   ;; a-share: share of agents with no confescated wealth
                set adj-share net-share ]
              ; else:
              [ set a-share net-share  ] ; end of else
               ] ; end of ask

      set total-a-share sum [a-share] of patches
      set total-c-share sum [c-share] of patches

      ; --- Safe Division for Factor ---
      set factor ifelse-value (total-a-share != 0) [ (total-a-share + total-c-share) / total-a-share ] [ 0 ]

      ask patches [
          if a-share > 0 [ set adj-share a-share * factor ]
          set acc-surplus adj-share * capital
          set surplus-share adj-share
        ] ; end of ask
      ] ; end of if total-c-wealth > 0
end



to update-net-wealth       ; we need to update debt and wealth after confiscating wealth.
   if total-c-wealth > 0 [
      set total-debt sum [debt] of patches
      set total-credit total-debt ; identity
      ask patches [
          set wealth surplus-share * (total-cash + total-credit)
          set net-wealth wealth - debt
          set net-worth max (list net-wealth 0)
          set c-wealth 0
          set net-share 0
          set adj-share 0
          ]
      set total-wealth sum [wealth] of patches
      ]
end


to update-bankruptcy
   ask patches [
       if default > 0
          [ ifelse default = delay-time + 1    ; if the agent has been in defualt for the period of delay-time + 1, then he is released from bankruptcy
              [ set default 0
                set income abs(random-normal mean-income std)
                set consumption mpc * income
                set fresh-surplus 10
                set pcolor scale-color brown (consumption) 1 139
                ]
              ; else
              [ declare-bankruptcy ] ; end of else
          ] ; end of if default > 0
       ] ; end of ask



       ; update counting
       let past-bankrupt bankrupt
       set bankrupt count patches with [default > 0]
       let d-bankrupt max (list (bankrupt - past-bankrupt) 0)
       set acc-bankrupt acc-bankrupt + d-bankrupt

end


to generate-income
    ask patches [
          if default = 0
              [ ;; Generate income using a truncated normal distribution
                set income max (list 0 (random-normal mean-income (std * mean-income)))

                set net-income ( income + interest-c + markup-c - amount-due )
                ifelse net-income < 0
                    [ set past-due abs(net-income)
                      set payment max (list (amount-due - past-due) 0)
                      ]
                    [ set payment amount-due
                      set past-due 0 ]

                set p-income max (list net-income 0)

                ;; ----------------------------------------------------
                ;; DYNAMIC MPC & MPC-W CALCULATION (With Proportional Noise)
                ;; ----------------------------------------------------
                let lambda (1 / (mean-income + 0.01))

                ; 1. Calculate the theoretical baseline on the curve
                let base-mpc mpc-min + (mpc-max - mpc-min) * exp (-1 * lambda * p-income)

                ; 2. Apply the stochastic noise proportionally
                set mpc base-mpc + (random-float (2 * std-mpc * base-mpc)) - (std-mpc * base-mpc)

                ; 3. Safety bounds to prevent impossible economic behavior
                if mpc > 0.99 [ set mpc 0.99 ]
                if mpc < 0 [ set mpc 0 ]


                ;; --- For Wealth ---
                let lambda-w (1 / ((mean-income * 5) + 0.01))

                let base-mpc-w mpc-w-min + (mpc-w-max - mpc-w-min) * exp (-1 * lambda-w * net-worth)

                set mpc-w base-mpc-w + (random-float (2 * std-mpc-w * base-mpc-w)) - (std-mpc-w * base-mpc-w)

                if mpc-w > 0.99 [ set mpc-w 0.99 ]
                if mpc-w < 0 [ set mpc-w 0 ]
                ;; ----------------------------------------------------
             ]
        ]
end




to cal-payments
    ask patches [
        set interest-payment interest-share * payment
        set interest-past-due interest-share * past-due
        set markup-payment markup-share * payment
        set markup-past-due markup-share * past-due
        set principal-payment payment - interest-payment - markup-payment
        set interest-c surplus-share * total-interest-payment
        set markup-c surplus-share * total-markup-payment

        ]
    set total-payment sum [payment] of patches
    set total-principal-payment sum [principal-payment] of patches
    set total-markup-payment sum [markup-payment] of patches
    set total-interest-payment sum [interest-payment] of patches
    set total-interest-past-due sum [interest-past-due] of patches
    set total-markup-past-due sum [markup-past-due] of patches
    set total-acc-payment total-acc-payment + total-payment
    set total-acc-principal-payment total-acc-principal-payment + total-principal-payment
    set total-acc-markup-payment total-acc-markup-payment + total-markup-payment
    set total-acc-interest-payment total-acc-interest-payment + total-interest-payment
end





;; calculate ideal consumption level
to cal-c-star
  ask patches [
     set avg-consumption mean [consumption] of neighbors
     set c-1 (1 - d) * ( (mpc * p-income) + (mpc-w * net-worth) )
     set c-2 d * avg-consumption
     set c-star c-1 + c-2
     ]
end



to cal-deficit-surplus
   ask patches [
       if default = 0 [
         set gap p-income - c-star
         ifelse gap >= 0
           [ set surplus gap
             set deficit 0
             ]
           [ set deficit abs(gap)
             set surplus 0
             ]
        set acc-surplus acc-surplus + surplus + fresh-surplus

          ] ; end of if default = 0
      ] ; end of ask
   set total-deficit sum [deficit] of patches
   set total-surplus sum [surplus] of patches
   set total-fresh-surplus sum [fresh-surplus] of patches
   set in-flow in-flow + total-surplus + total-principal-payment
   set capital capital + total-surplus + total-fresh-surplus
   set out-flow out-flow + total-loan

end



to cal-donations
    ask patches [
        ifelse net-worth >= net-worth-ag
            [ set donor 1
              set donation (z / 1200) * net-worth
              set charity 0 ]
            [ set donation 0
              ifelse deficit > 0
                [ set donor -1 ]
                [ set donor 0 ] ]
                ]

    ; calculate charity
    set total-donation sum [donation] of patches
    set total-charity sum [charity] of patches
    set z-funds z-funds + total-donation - total-charity
    set eligible-deficit sum [deficit] of patches with [net-worth < net-worth-ag]
    if eligible-deficit = 0 [set eligible-deficit 1]
    set z-share z-funds / eligible-deficit
    if z-share > 1 [set z-share 1]
end



to cal-loan-share
   set loan-funds loan-funds + total-surplus + total-principal-payment - total-loan ; this is a measure of cash-stock available for lending before consumption is actiually set.
       if loan-funds < 0
         [set loan-funds 0
          user-message "negative loan-funds"]

   let total-deficit-1 max (list total-deficit 1)
   set loan-share min (list (loan-funds / total-deficit-1) 1)
   if allow-lending = false [ set loan-share 0 ]
end




to set-consumption
   ask patches [
       if default = 0 [
          ifelse gap >= 0
             [ set consumption c-star
               set loan 0
               set charity 0 ]

             ;else, if gap < 0, then:
             [ ifelse net-worth < net-worth-ag
                 [ set charity z-share * deficit
                   set donation 0 ]
                 [ set charity 0 ]; end of second ifesle

               set loan loan-share * (deficit - charity)
               set consumption (p-income + loan + charity) ]; end of first else.

          ; check markup condition
          if limit-loan = true
             [ set loan 0
               set consumption (p-income + charity)
               set limit-loan false ]
          set pcolor scale-color brown (consumption) 1 139
          ] ]
end


to cal-debt

   ask patches [
     if default = 0 [
       set principal-debt max (list (principal-debt + loan - principal-payment) 0) ;
       set markup-debt max (list (markup-debt + (loan-period * (m / 1200) * loan) - markup-payment) 0)
       set interest-debt max (list (interest-debt + (loan-period * (r / 1200) * debt) - interest-payment) 0)
       set gross-debt principal-debt + interest-debt + markup-debt
       set debt max (list (principal-debt + markup-past-due + interest-past-due) 0)
       set acc-payment acc-payment + payment
       if (markup-debt > 0 and interest-debt > 0) [user-message "warning: m & r > 0"]; just to check

 ; calculate installment and interest:
       set amount-due gross-debt / loan-period
       set interest-due interest-debt / loan-period
       set markup-due markup-debt / loan-period
       let gross-debt-1 max (list gross-debt 1)
       set interest-share interest-debt / gross-debt-1
       set markup-share markup-debt / gross-debt-1
        ] ; end of if
     ] ; end of ask.

    set total-amount-due sum [amount-due] of patches
    set total-debt sum [debt] of patches
    set total-credit total-debt ; identity
    set total-loan sum [loan] of patches
    ; update-loans
    ask patches [
          set acc-loan acc-loan + loan
          if loan > 0 [ set no-of-loans no-of-loans + 1]
          ] ; end of update-loans

end




to cal-surplus-shares
   ask patches [
       if default = 0 [ set surplus-share acc-surplus / capital ]
       ]
end



to cal-wealth
     ; update cash stock:
     set total-cash loan-funds - total-loan
     ask patches [
        set wealth surplus-share * (total-cash + total-credit)
        set net-wealth wealth - debt
        set net-worth max (list (net-wealth - donation) 0)
        set fresh-surplus 0
        ]
    set total-wealth sum [wealth] of patches
    set total-net-worth sum [net-wealth] of patches
end




to declare-bankruptcy
          set default default + 1
          set pcolor red
          set debt 0
          set principal-debt 0
          set gross-debt 0
          set markup-debt 0
          set interest-debt 0
          set consumption 0
          set income 0
          set net-income 0
          set loan 0
          set amount-due 0
          set past-due 0
          set interest-due 0
          set interest-c 0
          set interest-payment 0
          set interest-past-due 0
          set principal-payment 0
          set markup-due 0
          set markup-c 0
          set markup-past-due 0
          set markup-payment 0
          set payment 0
          set credit 0
          set wealth 0
          set net-wealth 0
          set net-worth 0
          set surplus 0
          set deficit 0
          set gap 0
          set acc-surplus 0
          set surplus-share 0
          set fresh-surplus 0
end




to decide-consumption
      check-bankruptcy
      check-markup-limit
      cal-c-wealth
      adjust-shares
      update-net-wealth
      update-bankruptcy
      generate-income
      cal-payments
      cal-c-star
      cal-deficit-surplus
      cal-donations
      cal-loan-share
      set-consumption
      cal-debt
      cal-surplus-shares
      cal-wealth
end



to update-lorenz-and-gini
  let sorted-wealths sort [wealth] of patches
  let total-wealth-l sum sorted-wealths

  ;; Prevent division by zero if all wealth in the economy is wiped out
  if total-wealth-l = 0 [ set total-wealth-l 1 ]

  let wealth-sum-so-far 0
  let index 0
  set gini-index-reserve 0
  set lorenz-points []
  let total-patches count patches

  ;; now actually plot the Lorenz curve -- along the way, we also
  ;; calculate the Gini index.
  repeat total-patches [
    set wealth-sum-so-far (wealth-sum-so-far + item index sorted-wealths)
    set lorenz-points lput ((wealth-sum-so-far / total-wealth-l) * 100) lorenz-points
    set index (index + 1)
    set gini-index-reserve gini-index-reserve + (index / total-patches) - (wealth-sum-so-far / total-wealth-l)
  ]
end


to cal-averages
      set consumption-ag (mean [consumption] of patches)
      set net-income-ag mean [net-income] of patches
      set net-worth-ag mean [net-worth] of patches
      set wealth-ag mean [wealth] of patches
      set net-wealth-ag mean [net-wealth] of patches
end

to cal-medians
      set consumption-md median [consumption] of patches
      set net-income-md median [net-income] of patches
      set net-worth-md median [net-worth] of patches
      set wealth-md median [wealth] of patches
      set net-wealth-md median [net-wealth] of patches
end



to cal-vars
  set var-c ifelse-value (consumption-ag != 0)
    [ (standard-deviation [consumption] of patches) / consumption-ag ] [ 0 ]

  set var-y ifelse-value (net-income-ag != 0)
    [ (standard-deviation [net-income] of patches) / net-income-ag ] [ 0 ]

  set var-nw ifelse-value (net-wealth-ag != 0)
    [ (standard-deviation [net-wealth] of patches) / net-wealth-ag ] [ 0 ]

  set var-w ifelse-value (wealth-ag != 0)
    [ (standard-deviation [wealth] of patches) / wealth-ag ] [ 0 ]
end


to go
  set time time + 1
  decide-consumption
  cal-averages
  cal-medians
  cal-vars
  update-lorenz-and-gini
  tick
  if time = set-time-end
    [ print (word "End at " date-and-time)
      stop ]


end]]></code>
  <widgets>
    <view x="823" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-17" height="429" showTickCounter="true" patchSize="12.0" fontSize="10" wrappingAllowedY="true" width="428" tickCounterLabel="ticks" maxPycor="17" updateMode="1" maxPxcor="17" minPxcor="-17"></view>
    <switch x="5" y="380" height="33" on="true" variable="fix-random-seed" display="fix-random-seed" width="138" sizeVersion="0"></switch>
    <slider x="152" step="5" y="12" max="150" display="avg-income" height="33" min="0" direction="Horizontal" default="75.0" variable="avg-income" width="160" sizeVersion="0"></slider>
    <slider x="13" step="0.05" y="12" max="1" display="relativity" height="33" min="0" direction="Horizontal" default="0.5" variable="relativity" width="139" sizeVersion="0"></slider>
    <slider x="153" step="0.05" y="78" max="0.5" display="std" height="33" min="0" direction="Horizontal" default="0.15" variable="std" width="159" sizeVersion="0"></slider>
    <slider x="5" step="0.25" y="312" max="10" display="z" height="33" min="0" direction="Horizontal" default="0.0" variable="z" units="p.a.%" width="138" sizeVersion="0"></slider>
    <switch x="5" y="180" height="33" on="true" variable="allow-lending" display="allow-lending" width="138" sizeVersion="0"></switch>
    <slider x="5" step="1" y="212" max="25" display="m" height="33" min="0" direction="Horizontal" default="6.0" variable="m" units="p.a.%" width="138" sizeVersion="0"></slider>
    <slider x="5" step="1" y="246" max="25" display="r" height="33" min="0" direction="Horizontal" default="0.0" variable="r" units="p.a.%" width="138" sizeVersion="0"></slider>
    <switch x="5" y="279" height="33" on="true" variable="limit-amount-due" display="limit-amount-due" width="138" sizeVersion="0"></switch>
    <slider x="5" step="10" y="346" max="3000" display="set-time-end" height="33" min="0" direction="Horizontal" default="1500.0" variable="set-time-end" width="138" sizeVersion="0"></slider>
    <button x="5" y="413" height="33" disableUntilTicks="false" forever="false" kind="Observer" width="63" sizeVersion="0">setup</button>
    <button x="5" y="445" height="33" disableUntilTicks="false" forever="true" kind="Observer" width="63" sizeVersion="0">go</button>
    <plot x="368" autoPlotX="true" yMax="10.0" autoPlotY="true" y="161" xMin="0.0" height="150" legend="false" xMax="10.0" yMin="0.0" xAxis="Time" display="Net-wealth" width="235" sizeVersion="0">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-7500403" legend="true">
        <setup></setup>
        <update>plot net-wealth-ag ; plots average net-wealth</update>
      </pen>
    </plot>
    <plot x="602" autoPlotX="true" yMax="10.0" autoPlotY="true" y="161" xMin="0.0" height="150" legend="false" xMax="10.0" yMin="0.0" xAxis="Time" display="Income" width="220" sizeVersion="0">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-7500403" legend="true">
        <setup></setup>
        <update>plot net-income-ag ; plots average net-income</update>
      </pen>
    </plot>
    <plot x="146" autoPlotX="true" yMax="100.0" autoPlotY="true" y="161" xMin="0.0" height="150" legend="false" xMax="100.0" yMin="0.0" xAxis="Time" display="Consumption" width="222" sizeVersion="0">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot consumption-ag; plots average consumption</update>
      </pen>
    </plot>
    <plot x="582" autoPlotX="true" yMax="10.0" autoPlotY="true" y="310" xMin="0.0" height="150" legend="true" xMax="10.0" yMin="0.0" display="Surplus &amp; Deficit" width="240" sizeVersion="0">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="surplus" color="-10899396" legend="true">
        <setup></setup>
        <update>plot total-surplus / count patches</update>
      </pen>
      <pen interval="1.0" mode="0" display="deficit" color="-2674135" legend="true">
        <setup></setup>
        <update>plot total-deficit / count patches</update>
      </pen>
    </plot>
    <plot x="325" autoPlotX="true" yMax="10.0" autoPlotY="true" y="310" xMin="0.0" height="150" legend="true" xMax="10.0" yMin="0.0" display=" Payments" width="258" sizeVersion="0">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="r/m" color="-8630108" legend="true">
        <setup></setup>
        <update>plot (total-interest-payment + total-markup-payment) / count patches
; plots interest-payment or markup-payment (but not both)</update>
