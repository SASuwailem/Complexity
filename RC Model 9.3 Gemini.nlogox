loan-funds / count patches</monitor>
    <monitor x="584" precision="2" y="117" height="45" fontSize="11" display="demand" width="55" sizeVersion="0"><![CDATA[; demand for loans
ifelse-value (count patches with [deficit > 0] > 0) [ total-deficit / count patches with [deficit > 0] ] [ 0 ]]]></monitor>
    <slider x="13" step="0.025" y="45" max="2" display="std-r" height="33" min="0" direction="Horizontal" default="0.3" variable="std-r" units="ratio" width="139" sizeVersion="0"></slider>
